# Copier ce fichier en .env (jamais versionné) et adapter les valeurs

# Chemin de la base SQLite (relatif à la racine du projet)
DATABASE_PATH=data/app.db

# Préfixe d'URL sous lequel l'application est montée par le reverse proxy
ROOT_PATH=/real-estate-manager

# Boîte Gmail dédiée (IMAP + mot de passe d'application — voir CLAUDE.md,
# PAS le mot de passe normal du compte). Laisser vide tant que le compte
# Gmail dédié n'est pas prêt.
GMAIL_IMAP_HOTE=imap.gmail.com
GMAIL_IMAP_PORT=993
GMAIL_IMAP_ADRESSE=
GMAIL_IMAP_MOT_DE_PASSE=
