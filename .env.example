# Copier ce fichier en .env (jamais versionné) et adapter les valeurs

# Chemin de la base SQLite (relatif à la racine du projet)
DATABASE_PATH=data/app.db

# Préfixe d'URL sous lequel l'application est montée par le reverse proxy
ROOT_PATH=/real-estate-manager

# Clé de signature des sessions — générer avec :
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Ne jamais garder la valeur par défaut en production.
SECRET_KEY=dev-secret-key-a-ne-jamais-utiliser-en-production

# À passer à true une fois déployé derrière le reverse proxy mTLS qui termine
# le HTTPS (et qui doit alors transmettre l'en-tête X-Forwarded-Proto).
SESSION_COOKIE_HTTPS_ONLY=false

# Adresse/port d'écoute de l'application (utilisés par `python -m app.main`,
# donc par le service systemd). 127.0.0.1 par défaut pour le dev local.
# EN PRODUCTION : le reverse proxy qui termine le TLS tourne sur un AUTRE
# Raspberry Pi — mettre APP_HOST=0.0.0.0 (ou l'IP LAN de ce Pi) pour qu'il
# puisse joindre l'application sur le réseau.
APP_HOST=127.0.0.1
APP_PORT=8000

# Boîte Gmail dédiée (IMAP + mot de passe d'application — voir CLAUDE.md,
# PAS le mot de passe normal du compte). Laisser vide tant que le compte
# Gmail dédié n'est pas prêt.
GMAIL_IMAP_HOTE=imap.gmail.com
GMAIL_IMAP_PORT=993
GMAIL_IMAP_ADRESSE=
GMAIL_IMAP_MOT_DE_PASSE=
